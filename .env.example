# 复制此文件为 .env 并填入真实值（.env 不会进入 Git 和镜像）
# ---- 火山引擎（字幕生成：录音文件识别；音效生成：seed-audio）----
VOLC_APP_ID=3952155908
VOLC_ACCESS_TOKEN=你的AccessToken
VOLC_SECRET_KEY=你的SecretKey
# 如使用新版控制台单 API Key，则填这里并优先生效
VOLC_API_KEY=
# ASR 资源 ID（默认豆包录音文件识别 2.0，多个用英文逗号分隔做漫游兜底）
VOLC_RESOURCE_ID=volc.seedasr.auc
VOLC_RESOURCES=volc.seedasr.auc,volc.bigasr.auc

# ---- 对象存储 S3（文件上传与音效持久化；不填则相关功能不可用）----
COZE_BUCKET_ENDPOINT_URL=
COZE_BUCKET_NAME=
